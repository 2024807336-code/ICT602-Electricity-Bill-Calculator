<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bill Details"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#173C43"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month"
                android:textColor="#64748B"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailMonth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="January"
                android:textColor="#173C43"
                android:textSize="18sp"
                android:paddingBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity Units (kWh)"
                android:textColor="#64748B"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailUnits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="467 kWh"
                android:textColor="#173C43"
                android:textSize="18sp"
                android:paddingBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Charges"
                android:textColor="#64748B"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailTotalCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RM 163.172"
                android:textColor="#173C43"
                android:textSize="18sp"
                android:paddingBottom="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rebate Percentage"
                android:textColor="#64748B"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailRebate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5%"
                android:textColor="#173C43"
                android:textSize="18sp"
                android:paddingBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_final_cost"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Final Cost After Rebate"
                    android:textColor="#236B45"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailFinalCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RM 155.01"
                    android:textColor="#236B45"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnBackDetail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#087E78"
            android:text="Back to Records"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
