<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6F8"
    android:padding="20dp">

    <!-- Page Title -->
    <TextView
        android:id="@+id/tvRecordsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Electricity Bill Records"
        android:textColor="#173C43"
        android:textSize="23sp"
        android:textStyle="bold"
        android:padding="10dp" />

    <!-- List Instructions -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a record to view its details"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:padding="10dp" />

    <!-- Empty Message -->
    <TextView
        android:id="@+id/tvEmptyRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No electricity records found."
        android:textColor="#64748B"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <!-- ListView -->
    <ListView
        android:id="@+id/listViewBills"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE3EA"
        android:dividerHeight="1dp"
        android:background="#FFFFFF" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBackRecords"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#087E78"
        android:text="Back to Calculator"
        android:textColor="#FFFFFF"
        android:textAllCaps="false" />

</LinearLayout>
