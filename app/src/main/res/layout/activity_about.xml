<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Application"
            android:textColor="#173C43"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Student Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgStudent"
                android:layout_width="82dp"
                android:layout_height="96dp"
                android:src="@drawable/studentphoto"
                android:scaleType="centerCrop"
                android:contentDescription="Student picture" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDENT PROFILE"
                    android:textColor="#087E78"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="MUHAMMAD AZRUL BIN ISMAIL"
                    android:textColor="#173C43"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Student ID: 2024807336&#10;ICT602 | Mobile Technology and Development"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- GitHub Website Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APPLICATION WEBSITE"
                android:textColor="#087E78"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGithubLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="https://github.com/2024807336-code/ICT602-Electricity-Bill-Calculator"
                android:textColor="#087E78"
                android:textSize="12sp"
                android:autoLink="web"
                android:linksClickable="true" />

        </LinearLayout>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBackAbout"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#087E78"
            android:text="Back to Calculator"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- How to Use Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HOW TO USE"
                android:textColor="#087E78"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="1. Select your billing month.&#10;&#10;2. Enter electricity usage between 1 and 1000 kWh.&#10;&#10;3. Enter a rebate percentage between 0% and 5%.&#10;&#10;4. Press Calculate Bill to view your total charges and final cost.&#10;&#10;5. Your bill will be automatically saved.&#10;&#10;6. Open View Records to view, edit or delete your saved bills."
                android:textColor="#475569"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- Copyright -->
        <TextView
            android:id="@+id/tvCopyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="© 2026 Muhammad Azrul Bin Ismail. All Rights Reserved."
            android:textColor="#94A3B8"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>
